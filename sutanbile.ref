    var sticky, checked = !1;
    $(document).ready(function() {
        $(window).scroll(function() {
            sticky = $(window).scrollTop(),
            sticky > 180 && 0 == checked ? ($(".header").addClass("top"),
            checked = !0) : 180 > sticky && 1 == checked && ($(".header").removeClass("top"),
            checked = !1)
        })
    });
    $(document).ready(function() {
        $(document).on('click', '.accHeader', function() {
            $('.accHeader').not($(this)).removeClass('open');
            $('.accContent').not($(this).next()).slideUp();
            $(this).toggleClass('open');
            $(this).next().slideToggle()
        })
    });
    jQuery(document).ready(function($) {
        $(".schema-faq-answer").hide();
        $(".schema-faq-section:first .schema-faq-answer").show();
        $(".schema-faq-section:first .schema-faq-question").addClass("active");
        $(".schema-faq-question").click(function() {
            if ($(this).hasClass("active")) {
                $(this).removeClass("active").next(".schema-faq-answer").slideUp()
            } else {
                $(".schema-faq-answer").slideUp();
                $(".schema-faq-question").removeClass("active");
                $(this).addClass("active").next(".schema-faq-answer").slideDown()
            }
        })
    });
    (function() {
        let loaded = !1;
        function loadGLightboxAssets() {
            if (loaded)
                return;
            loaded = !0;
            const link = document.createElement('link');
            link.rel = 'stylesheet';
            link.href = 'https://www.sustainablemindz.net/wp-content/themes/sustainablemindz/glightbox.min.css';
            document.head.appendChild(link);
            const script = document.createElement('script');
            script.src = 'https://www.sustainablemindz.net/wp-content/themes/sustainablemindz/js/glightbox.min.js?v=1.0.4';
            script.onload = () => {
                const lightbox = GLightbox({
                    touchNavigation: !0,
                    loop: !0,
                    slideEffect: "zoom",
                    autoplayVideos: !0,
                    zoomable: !0
                })
            }
            ;
            document.body.appendChild(script)
        }
        function onScroll() {
            if (window.scrollY > 200) {
                loadGLightboxAssets();
                cleanup()
            }
        }
        function onMouseMove() {
            loadGLightboxAssets();
            cleanup()
        }
        function cleanup() {
            window.removeEventListener('scroll', onScroll);
            window.removeEventListener('mousemove', onMouseMove)
        }
        window.addEventListener('scroll', onScroll);
        window.addEventListener('mousemove', onMouseMove)
    }
    )();
    document.addEventListener("DOMContentLoaded", function() {
        gsap.registerPlugin(ScrollTrigger);
        function splitTextToChars(element) {
            if (!element)
                return;
            const childNodes = Array.from(element.childNodes);
            childNodes.forEach(node => {
                if (node.nodeType === 3) {
                    const text = node.textContent;
                    if (!text.trim() && text.includes('\n'))
                        return;
                    const wrappedText = text.replace(/([^\s])/g, "<span class='char-wrap'>$1</span>");
                    const tempDiv = document.createElement('span');
                    tempDiv.innerHTML = wrappedText;
                    while (tempDiv.firstChild) {
                        element.insertBefore(tempDiv.firstChild, node)
                    }
                    element.removeChild(node)
                } else if (node.nodeType === 1) {
                    if (!node.classList.contains('blur-text') && node.tagName !== 'BR' && node.tagName !== 'SVG' && !node.classList.contains('char-wrap')) {
                        splitTextToChars(node)
                    }
                }
            }
            )
        }
        const flyingElements = document.querySelectorAll(".fly-text");
        flyingElements.forEach(element => {
            splitTextToChars(element);
            const timeline = gsap.timeline({
                scrollTrigger: {
                    trigger: element,
                    start: "top 85%",
                    toggleActions: "play none none none"
                }
            });
            const chars = element.querySelectorAll(".char-wrap");
            if (chars.length > 0) {
                timeline.fromTo(chars, {
                    x: -30,
                    opacity: 0
                }, {
                    x: 0,
                    opacity: 1,
                    duration: 0.8,
                    stagger: 0.02,
                    ease: "back.out(1.7)"
                }, 0)
            }
            const internalBlurs = element.querySelectorAll(".blur-text");
            if (internalBlurs.length > 0) {
                timeline.fromTo(internalBlurs, {
                    opacity: 0,
                    filter: "blur(10px)"
                }, {
                    opacity: 1,
                    filter: "blur(0px)",
                    duration: 1,
                    ease: "power2.out"
                }, 0)
            }
        }
        );
        const standaloneBlurs = document.querySelectorAll(".blur-text:not(.fly-text .blur-text)");
        standaloneBlurs.forEach(element => {
            gsap.fromTo(element, {
                opacity: 0,
                filter: "blur(50px)"
            }, {
                opacity: 1,
                filter: "blur(0px)",
                duration: 5,
                ease: "back.out(1.7)",
                scrollTrigger: {
                    trigger: element,
                    start: "top 85%",
                    toggleActions: "play none none none"
                }
            })
        }
        );
        gsap.utils.toArray(".counterIn").forEach(counter => {
            const finalValue = parseFloat(counter.innerText);
            const isDecimal = counter.innerText.includes(".");
            const snapVal = isDecimal ? 0.1 : 1;
            gsap.fromTo(counter, {
                innerText: 0
            }, {
                innerText: finalValue,
                duration: 4,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: counter,
                    start: "top 85%",
                    toggleActions: "play none none none"
                },
                snap: {
                    innerText: snapVal
                },
                onUpdate: function() {
                    this.targets()[0].innerText = isDecimal ? parseFloat(this.targets()[0].innerText).toFixed(1) : Math.round(this.targets()[0].innerText)
                }
            })
        }
        );
        const stickySections = document.querySelectorAll(".pinned-container section");
        function updateStickyPositions() {
            const windowHeight = window.innerHeight;
            stickySections.forEach(section => {
                const cardHeight = section.offsetHeight;
                let targetTop = 0;
                if (cardHeight > windowHeight) {
                    targetTop = -(cardHeight - windowHeight)
                } else {
                    targetTop = 80
                }
                section.style.top = targetTop + "px"
            }
            )
        }
        updateStickyPositions();
        window.addEventListener('resize', updateStickyPositions);
        ScrollTrigger.addEventListener("refreshInit", updateStickyPositions);
        ScrollTrigger.refresh();
        stickySections.forEach( (section, i) => {
            if (i < stickySections.length - 1) {
                const nextSection = stickySections[i + 1];
                gsap.to(section, {
                    scale: 0.9,
                    opacity: 0.6,
                    ease: "none",
                    scrollTrigger: {
                        trigger: nextSection,
                        start: "top bottom",
                        end: "top top",
                        scrub: !0,
                    }
                })
            }
        }
        );
        gsap.utils.toArray(".reveal-up").forEach(elem => {
            gsap.fromTo(elem, {
                clipPath: "polygon(0% 100%, 100% 100%, 100% 100%, 0% 100%)"
            }, {
                clipPath: "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)",
                duration: 2,
                ease: "power3.out",
                scrollTrigger: {
                    trigger: elem,
                    start: "top 85%",
                    toggleActions: "play none none none"
                }
            });
            if (elem.tagName === 'IMG') {
                gsap.from(elem, {
                    scale: 1.2,
                    duration: 2,
                    ease: "power2.out",
                    scrollTrigger: {
                        trigger: elem,
                        start: "top 85%"
                    }
                })
            }
        }
        );
        gsap.utils.toArray(".reveal-left").forEach(elem => {
            gsap.fromTo(elem, {
                clipPath: "polygon(0% 0%, 0% 0%, 0% 100%, 0% 100%)"
            }, {
                clipPath: "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)",
                duration: 2,
                ease: "expo.out",
                scrollTrigger: {
                    trigger: elem,
                    start: "top 85%",
                    toggleActions: "play none none none"
                }
            })
        }
        );
        gsap.utils.toArray(".reveal-center").forEach(elem => {
            gsap.fromTo(elem, {
                clipPath: "inset(50% 50% 50% 50%)"
            }, {
                clipPath: "inset(0% 0% 0% 0%)",
                duration: 1.2,
                ease: "power3.inOut",
                scrollTrigger: {
                    trigger: elem,
                    start: "top 85%",
                    toggleActions: "play none none none"
                }
            })
        }
        );
        gsap.utils.toArray(".svg-draw path").forEach(path => {
            const length = path.getTotalLength();
            gsap.set(path, {
                strokeDasharray: length,
                strokeDashoffset: length,
                fill: "none"
            });
            gsap.to(path, {
                strokeDashoffset: 0,
                duration: 3.5,
                ease: "power3.inOut",
                scrollTrigger: {
                    trigger: path.closest('svg'),
                    start: "top 80%",
                    toggleActions: "play none none none"
                }
            })
        }
        )
    });
    jQuery(function($) {
        var $header = $('.header');
        var $sections = $('section');
        function updateHeaderTheme() {
            var scrollTop = $(window).scrollTop();
            var trigger = scrollTop + 120;
            $sections.each(function() {
                var $section = $(this);
                var top = $section.offset().top;
                var bottom = top + $section.outerHeight();
                if (trigger >= top && trigger < bottom) {
                    if ($section.hasClass('dark')) {
                        $header.removeClass('header-light').addClass('header-dark')
                    } else if ($section.hasClass('light')) {
                        $header.removeClass('header-dark').addClass('header-light')
                    }
                    return !1
                }
            })
        }
        $(window).on('load scroll', updateHeaderTheme)
    });
    $(document).on('click', '.menu-toggle', function() {
        $('body').toggleClass('menu-is-open');
        if ($('body').hasClass('menu-is-open')) {
            lenis.stop()
        } else {
            lenis.start()
        }
    });
    document.addEventListener('DOMContentLoaded', () => {
        const menuContent = document.querySelector('.menuContent');
        const originalMenu = document.querySelector('.mobile_menu');
        const track = document.createElement('div');
        track.className = 'menuTrack';
        menuContent.innerHTML = '';
        menuContent.appendChild(track);
        let level = 0;
        function createPanel(menu, title='') {
            const panel = document.createElement('div');
            panel.className = 'menuPanel';
            if (level > 0) {
                const backBtn = document.createElement('div');
                backBtn.className = 'back-btn';
                backBtn.textContent = '← Back';
                backBtn.addEventListener('click', () => {
                    level--;
                    track.style.transform = `translateX(-${level * 100}%)`;
                    track.removeChild(track.lastChild)
                }
                );
                panel.appendChild(backBtn)
            }
            const list = document.createElement('ul');
            list.className = 'mobile_menu';
            menu.querySelectorAll(':scope > li').forEach(li => {
                const newLi = li.cloneNode(!0);
                const submenu = li.querySelector(':scope > .sub-menu');
                const link = newLi.querySelector(':scope > a');
                if (submenu && link) {
                    newLi.querySelectorAll('.sub-menu').forEach(sm => sm.remove());
                    link.addEventListener('click', (e) => {
                        e.preventDefault();
                        level++;
                        const newPanel = createPanel(submenu);
                        track.appendChild(newPanel);
                        track.style.transform = `translateX(-${level * 100}%)`
                    }
                    )
                }
                list.appendChild(newLi)
            }
            );
            panel.appendChild(list);
            return panel
        }
        const firstPanel = createPanel(originalMenu);
        track.appendChild(firstPanel)
    }
    )
</script>
<script type="speculationrules">
    {
        "prefetch": [
            {
                "source": "document",
                "where": {
                    "and": [
